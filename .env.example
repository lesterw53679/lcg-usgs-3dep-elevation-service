ELEVATION_PROVIDER=py3dep
ELEVATION_SOURCE=tep
MAX_BATCH_SIZE=500
MAX_REQUEST_BODY_BYTES=1000000
UPSTREAM_TIMEOUT_SECONDS=60
UPSTREAM_MAX_CONCURRENCY=2
UPSTREAM_MAX_ATTEMPTS=3
HYRIVER_CACHE_NAME=/tmp/hyriver/aiohttp_cache.sqlite
HYRIVER_CACHE_NAME_HTTP=/tmp/hyriver/http_cache.sqlite
HYRIVER_CACHE_EXPIRE=604800
